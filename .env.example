# ---- AI provider selection ------------------------------------------------
# "ollama" runs through your own Ollama server (no API charges, no keys).
# "openai" is only used if you explicitly set it and configure a key + model.
AI_PROVIDER=ollama

# ---- Ollama (default provider) --------------------------------------------
# The primary model may be hosted: a model name ending in ":cloud" runs on
# Ollama's servers through your local Ollama server, which needs a one-time
# "ollama signin" on this machine. A plain local model needs no account.
# OLLAMA_FALLBACK_MODEL is used automatically when the primary model fails,
# so the app keeps answering while the hosted model is unavailable.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:cloud
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b
OLLAMA_FALLBACK_HOST=http://127.0.0.1:11434

# ---- Ollama hosted API (optional) -----------------------------------------
# With an API key the app can call Ollama's hosted API directly instead of
# going through the local server. The key is only ever sent to Ollama, never
# to a local host. Leave OLLAMA_API_HOST empty to keep using the local server.
OLLAMA_API_HOST=
OLLAMA_API_MODEL=gemma4:31b
OLLAMA_API_KEY=

# ---- OpenAI (optional, paid) ----------------------------------------------
# Leave OPENAI_API_KEY empty/unset to guarantee no OpenAI calls or charges.
# Needed for AI_PROVIDER=openai, and also for image generation and voice
# transcription (both call OpenAI from the server only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ---- Image generation (optional, paid) ------------------------------------
# Reuses OPENAI_API_KEY. Defaults to the low quality tier, one image per
# request, and an allow-list of sizes. Leave the model empty for gpt-image-1.
BDM_IMAGE_MODEL=

# ---- Voice transcription (optional, paid) ---------------------------------
# Reuses OPENAI_API_KEY. Recordings are sent to OpenAI for transcription and
# are never stored by BDM. Leave empty for the recommended gpt-transcribe.
BDM_TRANSCRIBE_MODEL=

# ---- Web research (optional) ----------------------------------------------
# One provider is enough; the first configured one is used unless
# BDM_SEARCH_PROVIDER names one explicitly: brave | tavily | searxng.
# Only the user's question is sent to the provider - never conversation
# history, memories, or documents.
BDM_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Base URL of a self-hosted SearXNG instance with the JSON API enabled.
SEARXNG_URL=

# ---- Supabase (auth, conversation persistence, long-term memory) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Email sending (optional; Resend) --------------------------------------
# All three are required before /api/email/send will do anything:
#   BDM_EMAIL_ENABLED must be exactly "true" (explicit opt-in)
#   RESEND_API_KEY is the server-side Resend key
#   RESEND_FROM_EMAIL is the verified sender, e.g. "BDM <ai@yourdomain.com>"
# The key never reaches the browser. AI drafts are reviewed and confirmed by
# the user before anything is sent.
BDM_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Webhook signing secret (Resend dashboard -> Webhooks). Svix scheme.
RESEND_WEBHOOK_SECRET=
# Server-only. Required for durable webhook storage; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Durable usage quotas --------------------------------------------------
# Enforced in Supabase by supabase/migrations/0002_usage_quotas.sql. The
# defaults below are the built-in values; override only if you need to.
# Paid features fail closed (503) if the migration is not applied.
BDM_QUOTA_IMAGE_DAILY=20
BDM_QUOTA_IMAGE_BURST=5
BDM_QUOTA_TRANSCRIBE_DAILY=50
BDM_QUOTA_TRANSCRIBE_BURST=10
BDM_QUOTA_RESEARCH_DAILY=40
BDM_QUOTA_RESEARCH_BURST=10
BDM_QUOTA_EMAIL_DAILY=20
BDM_QUOTA_EMAIL_DRAFT_DAILY=50
BDM_QUOTA_VERIFY_EMAIL_DAILY=5
BDM_QUOTA_VERIFY_ATTEMPT_HOURLY=10
BDM_QUOTA_RESET_EMAIL_DAILY=5
BDM_QUOTA_RESET_ATTEMPT_HOURLY=10

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
