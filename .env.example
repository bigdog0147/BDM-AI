# ---- AI provider selection (server-side only) -----------------------------
# Primary provider: "ollama" (default) or "openai". Keys must never use the
# NEXT_PUBLIC_ prefix, or they would be shipped to the browser.
AI_PROVIDER=ollama

# Optional single-shot fallback when the primary fails for a transient reason
# (timeout, network, HTTP 429, HTTP 5xx). Authentication, configuration, and
# malformed-response errors never trigger it. Values: none | openai | ollama.
# Must differ from AI_PROVIDER; leave as "none" to disable.
AI_FALLBACK_PROVIDER=none

# ---- Ollama Cloud (required on Render) ------------------------------------
# Requires BOTH OLLAMA_API_KEY and OLLAMA_API_MODEL. The app calls the
# documented cloud endpoint (https://ollama.com) directly. OLLAMA_API_HOST is
# an optional override and must be https and not localhost. The key is only
# ever sent to a non-local host.
OLLAMA_API_KEY=
OLLAMA_API_MODEL=
OLLAMA_API_HOST=

# ---- Ollama local (development only) --------------------------------------
# Used only when OLLAMA_API_KEY is unset. A local server is not reachable
# from Render; Render sets the RENDER variable itself, so do not add it here.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional same-provider model fallback after a transient failure. It is never
# used for 401/403/404 responses. Skip it when OLLAMA_HOST is localhost on
# Render, because it would also be unreachable.
OLLAMA_FALLBACK_MODEL=
OLLAMA_FALLBACK_HOST=

# ---- OpenAI (optional, paid) ----------------------------------------------
# Leave OPENAI_API_KEY empty/unset to guarantee no OpenAI calls or charges.
# Needed for AI_PROVIDER=openai, and also for image generation and voice
# transcription (both call OpenAI from the server only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ---- Image generation (optional, paid) ------------------------------------
# Reuses OPENAI_API_KEY. Defaults to the low quality tier, one image per
# request, and an allow-list of sizes. Leave the model empty for gpt-image-1.
BDM_IMAGE_MODEL=

# ---- Voice transcription (optional, paid) ---------------------------------
# Reuses OPENAI_API_KEY. Recordings are sent to OpenAI for transcription and
# are never stored by BDM. Leave empty for the recommended gpt-transcribe.
BDM_TRANSCRIBE_MODEL=

# ---- Web research (optional) ----------------------------------------------
# One provider is enough; the first configured one is used unless
# BDM_SEARCH_PROVIDER names one explicitly: brave | tavily | searxng.
# Only the user's question is sent to the provider - never conversation
# history, memories, or documents.
BDM_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Base URL of a self-hosted SearXNG instance with the JSON API enabled.
SEARXNG_URL=

# ---- Supabase (auth, conversation persistence, long-term memory) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Google sign-in (optional) --------------------------------------------
# A server-side OIDC authorization-code flow with PKCE. Create a "Web
# application" OAuth client in Google Cloud Console and register these exact
# redirect URIs:
#   http://localhost:3000/auth/callback/google
#   https://bdm-ai.onrender.com/auth/callback/google
# Then enable the Google provider in Supabase Auth with the same client ID and
# secret; signInWithIdToken uses that provider to mint the existing Supabase
# session. SUPABASE_SERVICE_ROLE_KEY (below) is also required so BDM can refuse
# to link an existing password account by matching email alone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. When empty, the callback is derived from the request origin.
GOOGLE_REDIRECT_URI=

# ---- Email sending (optional; Resend) --------------------------------------
# All three are required before /api/email/send will do anything:
#   BDM_EMAIL_ENABLED must be exactly "true" (explicit opt-in)
#   RESEND_API_KEY is the server-side Resend key
#   RESEND_FROM_EMAIL is the verified sender, e.g. "BDM <ai@yourdomain.com>"
# The key never reaches the browser. AI drafts are reviewed and confirmed by
# the user before anything is sent.
BDM_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Webhook signing secret (Resend dashboard -> Webhooks). Svix scheme.
RESEND_WEBHOOK_SECRET=
# Server-only. Required for durable webhook storage; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Durable usage quotas --------------------------------------------------
# Enforced in Supabase by supabase/migrations/0002_usage_quotas.sql. The
# defaults below are the built-in values; override only if you need to.
# Paid features fail closed (503) if the migration is not applied.
BDM_QUOTA_IMAGE_DAILY=20
BDM_QUOTA_IMAGE_BURST=5
BDM_QUOTA_TRANSCRIBE_DAILY=50
BDM_QUOTA_TRANSCRIBE_BURST=10
BDM_QUOTA_RESEARCH_DAILY=40
BDM_QUOTA_RESEARCH_BURST=10
BDM_QUOTA_EMAIL_DAILY=20
BDM_QUOTA_EMAIL_DRAFT_DAILY=50
BDM_QUOTA_VERIFY_EMAIL_DAILY=5
BDM_QUOTA_VERIFY_ATTEMPT_HOURLY=10
BDM_QUOTA_RESET_EMAIL_DAILY=5
BDM_QUOTA_RESET_ATTEMPT_HOURLY=10

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
