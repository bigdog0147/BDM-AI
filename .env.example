# ---- AI provider selection ------------------------------------------------
# Local-first by default. "ollama" runs on your machine (no API charges).
# "openai" is only used if you explicitly set it and configure a key + model.
AI_PROVIDER=ollama

# ---- Local Ollama (default provider) --------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# ---- OpenAI (optional, paid) ----------------------------------------------
# Leave OPENAI_API_KEY empty/unset to guarantee no OpenAI calls or charges.
# Only set these if you switch AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ---- Online research (NOT enabled locally) --------------------------------
# The built-in web_search tool belongs to the OpenAI provider and is not
# available in local Ollama mode. A separate, credential-free search adapter
# has not been implemented yet, so this stays disabled.
BDM_WEB_SEARCH_ENABLED=false

# ---- Supabase (for future auth/persistence/memory) ------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
